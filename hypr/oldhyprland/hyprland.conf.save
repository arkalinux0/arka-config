# #######################################################################################
# AUTOGENERATED HYPRLAND CONFIG.
# EDIT THIS CONFIG ACCORDING TO THE WIKI INSTRUCTIONS.
# #######################################################################################

# This is an example Hyprland config file.
# Refer to the wiki for more information.
# https://wiki.hypr.land/Configuring/

# Please note not all available settings / options are set here.
# For a full list, see the wiki

# You can split this configuration into multiple files
# Create your files separately and then link them to this file like this:
# source = ~/.config/hypr/myColors.conf

source = ~/.config/hypr/layout.conf

################
### MONITORS ###
################

# See https://wiki.hypr.land/Configuring/Monitors/
# monitor=,preferred,auto,auto
monitor=DP-5,2560x1440@120,auto,auto
monitor = eDP-1, 1920x1200@60.003,auto,1.25

###################
### MY PROGRAMS ###
###################

source = ~/.config/matugen/generated/hyprland-colors.conf
# See https://wiki.hypr.land/Configuring/Keywords/

# Set programs that you use
$terminal = foot
$fileManager = nemo
$menu = rofi -show drun


#################
### AUTOSTART ###
#################

# Autostart necessary processes (like notifications daemons, status bars, etc.)
# Or execute your favorite apps at launch like this:

exec-once = $terminal
# exec-once = nm-applet &
# exec-once = waybar & hyprpaper & firefox
# exec-once = hyprlax --config .config/hyprlax/hyprlax.toml
exec-once = waybar &
exec-once = waypaper --restore &
exec-once = copyq
exec-once = hyprctl setcursor catppuccin-mocha-mauve-cursors 28
exec-once = swaync &
exec-once = nm-applet &
exec-once = python  /home/andrea/.config/hypr/scripts/touchpad/touch1.py
# exec-once = sh ~/.local/bin/fastfetch-popup
# exec-once = $menu

#############################
### ENVIRONMENT VARIABLES ###
#############################

# See https://wiki.hypr.land/Configuring/Environment-variables/

env = XCURSOR_SIZE,24
env = HYPRCURSOR_SIZE,24


###################
### PERMISSIONS ###
###################

# See https://wiki.hypr.land/Configuring/Permissions/
# Please note permission changes here require a Hyprland restart and are not applied on-the-fly
# for security reasons

# ecosystem {
#   enforce_permissions = 1
# }

# permission = /usr/(bin|local/bin)/grim, screencopy, allow
# permission = /usr/(lib|libexec|lib64)/xdg-desktop-portal-hyprland, screencopy, allow
# permission = /usr/(bin|local/bin)/hyprpm, plugin, allow


#####################
### LOOK AND FEEL ###
#####################

# Refer to https://wiki.hypr.land/Configuring/Variables/

# https://wiki.hypr.land/Configuring/Variables/#general
#general {
#    gaps_in = 3
#    gaps_out = 5
#
#    border_size = 3

general {
    border_size = 3
    gaps_in = 3
    gaps_out = 10
    col.active_border = $primary
    col.inactive_border = rgba(313131ff)

    # https://wiki.hypr.land/Configuring/Variables/#variable-types for info about colors
#    col.active_border = rgba(33ccffee) rgba(00ff99ee) 45deg
#    col.inactive_border = rgba(595959aa)

    # Set to true enable resizing windows by clicking and dragging on borders and gaps
    resize_on_border = false

    # Please see https://wiki.hypr.land/Configuring/Tearing/ before you turn this on
    allow_tearing = false
}

# https://wiki.hypr.land/Configuring/Variables/#decoration
decoration {
    rounding = 10
    rounding_power = 5

    # Change transparency of focused and unfocused windows
    active_opacity = 0.95
    inactive_opacity = 0.85

    shadow {
        enabled = true
        range = 100
        render_power = 2
        color = rgba(000000ff)
        color = rgba(1a1a1aee)
    }

    # https://wiki.hypr.land/Configuring/Variables/#blur
    blur {
        enabled = false
        size = 3
        passes = 1

        vibrancy = 0.1696
    }
}
windowrule = opacity 0.85 0.75, match:class foot

# https://wiki.hypr.land/Configuring/Variables/#animations
animations {
    enabled = yes, please :)

    # Default curves, see https://wiki.hypr.land/Configuring/Animations/#curves
    #        NAME,           X0,   Y0,   X1,   Y1
    bezier = easeOutQuint,   0.23, 1,    0.32, 1
    bezier = easeInOutCubic, 0.65, 0.05, 0.36, 1
    bezier = linear,         0,    0,    1,    1
    bezier = almostLinear,   0.5,  0.5,  0.75, 1
    bezier = quick,          0.15, 0,    0.1,  1

    # Default animations, see https://wiki.hypr.land/Configuring/Animations/
    #           NAME,          ONOFF, SPEED, CURVE,        [STYLE]
    animation = global,        1,     10,    default
    animation = border,        1,     5.39,  easeOutQuint
    animation = windows,       1,     2.75,  easeOutQuint
    animation = windowsIn,     1,     3.1,   easeOutQuint, popin 0%
    animation = windowsOut,    1,     1.5,  linear,       popin 0%
    animation = fadeIn,        1,     1.73,  almostLinear
    animation = fadeOut,       1,     1.46,  almostLinear
    animation = fade,          1,     3.03,  quick
    animation = layers,        1,     3.81,  easeOutQuint
    animation = layersIn,      1,     4,     easeOutQuint, fade
    animation = layersOut,     1,     1.5,   linear,       fade
    animation = fadeLayersIn,  1,     1.79,  almostLinear
    animation = fadeLayersOut, 1,     1.39,  almostLinear
    animation = workspaces,    1,     1.94,  almostLinear, fade
    animation = workspacesIn,  1,     1.21,  almostLinear, fade
    animation = workspacesOut, 1,     1.94,  almostLinear, fade
    animation = zoomFactor,    1,     7,     quick
}

# Ref https://wiki.hypr.land/Configuring/Workspace-Rules/
# "Smart gaps" / "No gaps when only"
# uncomment all if you wish to use that.
# workspace = w[tv1], gapsout:0, gapsin:0
# workspace = f[1], gapsout:0, gapsin:0
# windowrule = bordersize 0, floating:0, onworkspace:w[tv1]
# windowrule = rounding 0, floating:0, onworkspace:w[tv1]
# windowrule = bordersize 0, floating:0, onworkspace:f[1]
# windowrule = rounding 0, floating:0, onworkspace:f[1]

# See https://wiki.hypr.land/Configuring/Dwindle-Layout/ for more
dwindle {
    pseudotile = true # Master switch for pseudotiling. Enabling is bound to mainMod + P in the keybinds section below
    preserve_split = true # You probably want this
}

# See https://wiki.hypr.land/Configuring/Master-Layout/ for more
master {
    new_status = master
}

scrolling {
    direction = up
}

# https://wiki.hypr.land/Configuring/Variables/#misc
misc {
    force_default_wallpaper = -1 # Set to 0 or 1 to disable the anime mascot wallpapers
    disable_hyprland_logo = false # If true disables the random hyprland logo / anime girl background. :(
}


#############
### INPUT ###
#############

# https://wiki.hypr.land/Configuring/Variables/#input
input {
    kb_layout = ch,ru
    kb_variant = fr,
    kb_model =
    kb_options = grp:alt_shift_toggle
    kb_rules =

    follow_mouse = 1

    sensitivity = 0 # -1.0 - 1.0, 0 means no modification.

    touchpad {
        natural_scroll = false
    }
}

# See https://wiki.hypr.land/Configuring/Gestures
gesture = 3, horizontal, workspace

# Device configs
device {
    name = epic-mouse-v1
    sensitivity = -0.5
}

device {
    name = at-translated-set-2-keyboard
}

# Example per-device config
# See https://wiki.hypr.land/Configuring/Keywords/#per-device-input-configs for more

###################
### KEYBINDINGS ###
###################

bind = SUPER, B, exec, ~/bin/notify-time
bind = CTRL ALT, S, exec, sh /home/andrea/Arch.sh

# See https://wiki.hypr.land/Configuring/Keywords/
$mainMod = SUPER # Sets "Windows" key as main modifier

#  Example binds, see https://wiki.hypr.land/Configuring/Binds/ for more
bind = $mainMod, T, exec, $terminal
bind = $mainMod, Q, killactive,
bind = $mainMod, M, fullscreen,
bind = $mainMod, E, exec, $fileManager
bind = $mainMod, F, togglefloating,
bind = $mainMod, R, exec, $menu
# bind = $mainMod, P, pseudo, # dwindle
bind = $mainMod, J, layoutmsg, togglesplit # dwindle

bind = , F11, exec,python /home/andrea/.config/hypr/scripts/touchpad/touch2.py
bindl = $mainMod_CTRL, L, exec, hyprlock & systemctl suspend

bind = $mainMod, H, exec, python /home/andrea/.config/hypr/scripts/layout-switcher/main.py

bind = $mainMod, G, exec, foot -a workspace --title "Lista Finestre" sh -c "python /home/andrea/.local/lista_finestre.py; echo; read -n 1"

bind = , XF86Launch2, exec,python /home/andrea/.config/hypr/scripts/touchpad/main.py
bind = CTRL,Y,exec,grim -g "$(slurp)" ~/Pictures/screenshot-$(date +'%Y-%m-%d_%H-%M-%S').png
bind = CTRL_SHIFT,Y,exec,grim ~/Pictures/fullscreen-$(date +'%Y-%m-%d_%H-%M-%S').png
bind = CTRL_SHIFT, W, exec,brave https://web.whatsapp.com/
bind = SUPER SHIFT, 201,exec,brave "https://copilot.microsoft.com/"
bind = $mainMod, W , exec, python /home/andrea/.config/waybar/scripts/toggle-waybar-stats/main.py
bind = CTRL , W , exec, /home/andrea/.config/waybar/scripts/toggle-workspaces/execute.sh

bind = , XF86AudioRaiseVolume, exec, pamixer -i 5 && avizo-client volume
bind = , XF86AudioLowerVolume, exec, pamixer -d 5 && avizo-client volume
bind = , XF86AudioMute, exec, pamixer -t && avizo-client volume

bind = ,XF86AudioRaiseVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ && ~/.config/hypr/scripts/volume_osd.sh
bind = ,XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && ~/.config/hypr/scripts/volume_osd.sh
bind = ,XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && ~/.config/hypr/scripts/volume_osd.sh


bind = , XF86MonBrightnessUp, exec, brightnessctl set +5% && avizo-client brightness
bind = , XF86MonBrightnessDown, exec, brightnessctl set 5%- && avizo-client brightness


bind = $mainMod, P, exec, ~/.local/bin/fastfetch-popup
bind = $mainMod, K, exec, hyprctl kill

bind = $mainMod, V, exec, copyq toggle
bind = $mainMod, N, exec, swaync-client -t -sw

bind = $mainMod, L, exec, hyprlock
bind = $mainMod, SPACE, exec, foot -a btop btop
bind = $mainMod, C, exec, foot --app-id tty-clock /usr/bin/tty-clock -scf '%A %d.%m.%Y'
bind = $mainMod, Y, exec, EDITOR=nano kitty yazi
bind = $mainMod CTRL, C, exec, foot -a cava  /usr/bin/cava
bind = $mainMod CTRL, M, exec, ~/user_scripts/wlogout/wlogout_scale.sh

# Move focus with mainMod + arrow keys
bind = $mainMod, left, movefocus, l
bind = $mainMod, right, movefocus, r
bind = $mainMod, up, movefocus, u
bind = $mainMod, down, movefocus, d

binde = $mainMod CAPS, left, resizeactive, -15 0
binde = $mainMod CAPS, right, resizeactive, 15 0
binde = $mainMod CAPS, up, resizeactive, 0 -15
binde = $mainMod CAPS, down, resizeactive, 0 15

# Switch workspaces with mainMod + [0-9]
bind = $mainMod, 1, workspace, 1
bind = $mainMod, 2, workspace, 2
bind = $mainMod, 3, workspace, 3
bind = $mainMod, 4, workspace, 4
bind = $mainMod, 5, workspace, 5
bind = $mainMod, 6, workspace, 6
bind = $mainMod, 7, workspace, 7
bind = $mainMod, 8, workspace, 8
bind = $mainMod, 9, workspace, 9
bind = $mainMod, 0, workspace, 10

# bind = $mainMod SHIFT, Right, movetoworkspace, +1
# bind = $mainMod SHIFT, Left, movetoworkspace, -1
# bind = $mainMod CTRL, Right, workspace, e+1
# bind = $mainMod CTRL, Left, workspace, e-1
# bind = $mainMod SHIFT CTRL, Right, workspace, +1
# bind = $mainMod SHIFT CTRL, Left, workspace, -1

# Switch workspaces (custom)
bind = $mainMod CTRL, Right, exec, /home/andrea/.config/hypr/scripts/movetoworkspace/execute.sh + workspace true # next existing workspace
bind = $mainMod CTRL, Left, exec, /home/andrea/.config/hypr/scripts/movetoworkspace/execute.sh - workspace true # previous existing workspace
bind = $mainMod CTRL Shift, Right, exec, /home/andrea/.config/hypr/scripts/movetoworkspace/execute.sh + workspace false # next workspace
bind = $mainMod CTRL Shift, Left, exec, /home/andrea/.config/hypr/scripts/movetoworkspace/execute.sh - workspace false # previous workspace

# Move active window to workspace (custom)
bind = $mainMod SHIFT, Right, exec, /home/andrea/.config/hypr/scripts/movetoworkspace/execute.sh + movetoworkspace false # move active window to next workspace
bind = $mainMod SHIFT, Left, exec, /home/andrea/.config/hypr/scripts/movetoworkspace/execute.sh - movetoworkspace false # move active window to previous workspace

# Switch monitor focus (custom)
bind = $mainMod, A, exec, /home/andrea/.config/hypr/scripts/movetoworkspace/execute.sh switchmonitor
bind = $mainMod SHIFT, A, exec, /home/andrea/.config/hypr/scripts/movetoworkspace/execute.sh windowswitchmonitor

bind = $mainMod ALT, right, swapwindow, r
bind = $mainMod ALT, left, swapwindow, l
bind = $mainMod ALT, up, swapwindow, u
bind = $mainMod ALT, down, swapwindow, d

# Move active window to a workspace with mainMod + SHIFT + [0-9]
bind = $mainMod SHIFT, 1, movetoworkspace, 1
bind = $mainMod SHIFT, 2, movetoworkspace, 2
bind = $mainMod SHIFT, 3, movetoworkspace, 3
bind = $mainMod SHIFT, 4, movetoworkspace, 4
bind = $mainMod SHIFT, 5, movetoworkspace, 5
bind = $mainMod SHIFT, 6, movetoworkspace, 6
bind = $mainMod SHIFT, 7, movetoworkspace, 7
bind = $mainMod SHIFT, 8, movetoworkspace, 8
bind = $mainMod SHIFT, 9, movetoworkspace, 9
bind = $mainMod SHIFT, 0, movetoworkspace, 10

# Example special workspace (scratchpad)
bind = $mainMod, S, togglespecialworkspace, magic
bind = $mainMod SHIFT, S, movetoworkspace, special:magic

# Scroll through existing workspaces with mainMod + scroll
bind = $mainMod, mouse_down, workspace, e+1
bind = $mainMod, mouse_up, workspace, e-1

# Move/resize windows with mainMod + LMB/RMB and dragging
bindm = $mainMod, mouse:272, movewindow
bindm = $mainMod, mouse:273, resizewindow

# Laptop multimedia keys for volume and LCD brightness
bindel = ,XF86AudioRaiseVolume, exec, wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindel = ,XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindel = ,XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindel = ,XF86AudioMicMute, exec, wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindel = ,XF86MonBrightnessUp, exec, brightnessctl -e4 -n2 set 5%+
bindel = ,XF86MonBrightnessDown, exec, brightnessctl -e4 -n2 set 5%-

# Requires playerctl
bindl = , XF86AudioNext, exec, playerctl next
bindl = , XF86AudioPause, exec, playerctl play-pause
bindl = , XF86AudioPlay, exec, playerctl play-pause
bindl = , XF86AudioPrev, exec, playerctl previous

##############################
### WINDOWS AND WORKSPACES ###
##############################

windowrule = float true, match:class tty-clock
windowrule = size 500 250, match:class tty-clock
windowrule = float true, match:class cava
windowrule = size 500 250, match:class cava
windowrule = float true, match:class btop
windowrule = size 670 505, match:class btop
windowrule = float true, match:class fastfetchpopup
windowrule = size 1100 818, match:class fastfetchpopup
windowrule = float true, match:class workspace
windowrule = size 500 250, match:class workspace

# See https://wiki.hypr.land/Configuring/Window-Rules/ for more
# See https://wiki.hypr.land/Configuring/Workspace-Rules/ for workspace rules

# Example windowrule
# windowrule = float,class:^(kitty)$,title:^(kitty)$

# Ignore maximize requests from apps. You'll probably like this.
# windowrule = suppressevent maximize, class:.*

# Fix some dragging issues with XWayland
# windowrule = nofocus,class:^$,title:^$,xwayland:1,floating:1,fullscreen:0,pinned:0

windowrule = force_rgbx on,match:class MateEngineX.x86_64

# Dark mode GTK/Qt
exec = gsettings set org.gnome.desktop.interface color-scheme prefer-dark
exec = gsettings set org.gnome.desktop.interface gtk-theme Adwaita-dark
env = QT_QPA_PLATFORMTHEME,qt6ct


exec-once = ~/.config/hypr/overlays/scanlines.sh



;; ============================================================
;;  Barra: tre isole fluttuanti su sfondo trasparente
;; ============================================================
;; Una barra per monitor: scripts/session.py apre "bar-N" con --arg monitor=N
(defwindow bar [monitor]
  :monitor monitor
  :geometry (geometry :x "0" :y "0" :width "100%" :anchor "top center")
  :stacking "fg"
  :exclusive true
  :focusable false
  :namespace "eww-bar"
  (centerbox :class "bar"
    (box :halign "start" :space-evenly false
      ;; tiene vivo il servizio di sessione (eww avvia un listener solo se usato)
      (label :visible false :text {session.battery_span})
      (island-clock)
      (island-notif)
      (island-sys))
    (box :halign "center" :space-evenly false
      (island-workspaces :monitor monitor))
    (box :halign "end" :space-evenly false
      (island-media)
      (island-tray)
      (island-status))))

;; ============================================================
;;  Popup
;; ============================================================
;; Finestra trasparente a schermo intero sotto i popup: un click qui
;; chiude il popup aperto. Non copre la barra (rispetta la sua zona
;; esclusiva), quindi le isole restano cliccabili.
(defwindow closer
  :monitor 0
  :geometry (geometry :x "0" :y "0" :width "100%" :height "100%" :anchor "top left")
  :stacking "fg"
  :exclusive false
  :focusable false
  :namespace "eww-closer"
  (eventbox :class "closer"
            :onclick "${EWW_CONFIG_DIR}/scripts/popup.sh close"
            :onrightclick "${EWW_CONFIG_DIR}/scripts/popup.sh close"
            :onscroll "${EWW_CONFIG_DIR}/scripts/popup.sh close"))

(defwindow calendar
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :anchor "top left")
  :stacking "overlay"
  :exclusive false
  :focusable false
  :namespace "eww-popup"
  (revealer :transition "slidedown" :duration "200ms" :reveal reveal-calendar
    (box :class "popup calendar-box"
      (calendar))))

(defwindow dashboard
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "450px" :height "95%" :anchor "top right")
  :stacking "overlay"
  :exclusive false
  :focusable false
  :namespace "eww-popup"
  (revealer :transition "slideleft" :duration "200ms" :reveal reveal-dashboard
    (box :class "popup dashboard"
      (scroll :vscroll true :hscroll false :vexpand true
        (box :orientation "v" :space-evenly false :spacing 10 :class "dash-inner"
          (dash-header)
          (dash-toggles)
          (dash-sliders)
          (dash-weather)
          (dash-quick)
          (dash-apps)
          (dash-media)
          (dash-system)
          (dash-window)
          (dash-network)
          (dash-power))))))

;; OSD volume/luminosità: aperto/chiuso da scripts/osd.sh (tasti del portatile)
(defwindow osd
  :monitor 0
  :geometry (geometry :x "0" :y "70px" :width "340px" :anchor "bottom center")
  :stacking "overlay"
  :exclusive false
  :focusable false
  :namespace "eww-osd"
  (revealer :transition "crossfade" :duration "200ms" :reveal reveal-osd
    (osd-view)))
